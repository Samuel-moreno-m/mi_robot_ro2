<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="green"><color rgba="0 0.6 0 1"/></material>
  <material name="red"><color rgba="0.8 0 0 1"/></material>
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- Cilindro con el eje en Z (el lidar va de pie) -->
  <xacro:macro name="cylinder_z_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
    </collision>
    <xacro:box_inertia m="0.02" w="0.03" h="0.03" d="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <!-- Lidar -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <xacro:cylinder_z_inertia m="0.2" r="0.04" h="0.05"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.1 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- Camara -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
    </collision>
    <xacro:box_inertia m="0.1" w="0.03" h="0.09" d="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.215 0 0.02" rpy="0 0 0"/>
  </joint>

</robot>
